{
  "name": "penitentiary-center-root",
  "main": "electron/main.js",
  "version": "1.0.0",
  "description": "Sistema de gestión penitenciaria con Electron y React.",
  "author": "Tu Nombre o Equipo",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:back dev:front",
    "dev:back": "cd peny-back && npm run dev",
    "dev:front": "cd PenyFront && npm run dev",
    "front:ci-check": "cd PenyFront && npm run ci-check",
    "back:ci-check": "cd peny-back && npm run ci-check",
    "ci-check": "npm run front:ci-check && npm run back:ci-check",
    "dev:electron": "cross-env NODE_ENV=development electron --inspect=5858 electron/main.js",
    "dev:electron:watch": "tsc -p electron/tsconfig.json --watch",
    "build:frontend": "cd PenyFront && npm run build",
    "build:electron": "echo 'Electron ya está en JavaScript'",
    "build": "npm run build:frontend",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "dist": "npm run package",
    "dist:win": "npm run package:win",
    "start": "electron .",
    "clean": "rm -rf dist-electron PenyFront/dist release",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^24.9.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^38.4.0",
    "electron-builder": "^24.13.1",
    "npm-run-all": "^4.1.5"
  },
  "build": {
    "appId": "com.penitentiary.center",
    "productName": "PenitentiaryCenter",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "PenyFront/dist/**/*",
      "node_modules/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/*.md"
    ],
    "asarUnpack": [
      "PenyFront/dist/**/*"
    ],
    "extraResources": [],
    "win": {
      "icon": "assets/icons/logoWin.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PenitentiaryCenter"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null
  },
  "dependencies": {
    "@mantine/dropzone": "^8.3.4",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "puppeteer": "^24.26.1",
    "react-dropzone": "^14.3.8"
  }
}

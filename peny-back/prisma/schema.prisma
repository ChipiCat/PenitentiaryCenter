// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Base fields for all entities
// isDeleted: soft delete flag
// createdAt: creation timestamp
// updatedAt: last update timestamp
// createdBy: ID of user who created the record
// updatedBy: ID of user who last updated the record

enum UserRole {
  ADMIN
  DIRECTOR
  SECRETARY
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  role     UserRole @default(SECRETARY)
  photoFileId String? @unique
  isFirstLogin Boolean @default(true)

  // Base entity fields
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // Relations
  userAuth      UserAuth?
  createdUsers  User[]    @relation("UserCreatedBy")
  updatedUsers  User[]    @relation("UserUpdatedBy")
  createdByUser User?     @relation("UserCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?     @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  photoFile        File?    @relation("IdentityPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)


  @@map("users")
}

model UserAuth {
  id           String    @id @default(cuid())
  userId       String    @unique
  passwordHash String
  refreshToken String?
  tokenExpiry  DateTime?

  // Base entity fields
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_auth")
}

//////////////////////
// Prisoners module
//////////////////////

enum PrisonerStatus {
  Activo
  Trasladado
  Liberado
  Archivado
}

enum CitizenshipType {
  Local
  CiudadanoNacional
  CiudadanoExtranjero
}

enum Gender {
  Masculino
  Femenino
  Otro
}

enum MaritalStatus {
  Soltero
  Casado
  Viudo
  Divorciado
}

enum IdDocumentType {
  CedulaDeIdentidad
  Pasaporte
  Otro
}

enum PrisonerCategory {
  DerechoComun
  PrisionPreventiva
  PrisioneroAcusado
}

model Prisoner {
  id                 String         @id @default(cuid())
  registrationNumber String         @unique
  admissionDate      DateTime
  fiscalFileNumber   String?
  status             PrisonerStatus @default(Activo)

  // Base entity fields
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // Relations
  identity       PrisonerIdentity?
  personal       PrisonerPersonal?
  penitentiary   PrisonerPenitentiary?
  medicalRecords MedicalRecord[]
  belongings     PrisonerBelonging[]
  contacts       PrisonerContact[]
  children       PrisonerChild[]

  cases          PrisonerCase[]

  // Índices para optimizar búsquedas
  @@index([status, isDeleted])
  @@index([admissionDate])
  @@index([registrationNumber, isDeleted])
  @@index([fiscalFileNumber])
  @@index([createdAt])
  @@map("prisoners")
}

model PrisonerIdentity {
  id                     String           @id @default(cuid())
  prisonerId             String           @unique
  photoFileId            String?
  rightFingerprintFileId String?
  leftFingerprintFileId  String?
  surname                String
  firstName              String
  birthDate              DateTime?
  birthPlace             String?
  residence              String?
  citizenshipType        CitizenshipType?
  countryOfOrigin        String?
  nationalityType        String?
  nationality            String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  prisoner         Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)
  photoFile        File?    @relation("IdentityPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  rightFingerprint File?    @relation("RightFingerprint", fields: [rightFingerprintFileId], references: [id], onDelete: SetNull)
  leftFingerprint  File?    @relation("LeftFingerprint", fields: [leftFingerprintFileId], references: [id], onDelete: SetNull)

  // Índices para optimizar búsquedas
  @@index([surname, firstName])
  @@index([citizenshipType])
  @@index([countryOfOrigin])
  @@index([nationality])
  @@map("prisoner_identity")
}

model PrisonerPersonal {
  id               String          @id @default(cuid())
  prisonerId       String          @unique
  gender           Gender?
  fatherName       String?
  motherName       String?
  educationLevel   String?
  occupation       String?
  languages        String?
  maritalStatus    MaritalStatus?
  idDocumentType   IdDocumentType?
  idDocumentNumber String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  // Índices para optimizar búsquedas
  @@index([gender])
  @@index([maritalStatus])
  @@index([idDocumentNumber])
  @@map("prisoner_personal")
}

model PrisonerPenitentiary {
  id             String            @id @default(cuid())
  prisonerId     String            @unique
  category       PrisonerCategory?
  buildingNumber String?
  cellNumber     String?
  bedNumber      String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  // Índices para optimizar búsquedas
  @@index([category])
  @@index([buildingNumber, cellNumber])
  @@map("prisoner_penitentiary")
}

model MedicalRecord {
  id              String    @id @default(cuid())
  prisonerId      String
  doctorName      String?
  examinationDate DateTime?
  referenceNumber String?
  fileId        String?
  notes           String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)
  file     File?    @relation("MedicalFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@map("medical_records")
}

model PrisonerBelonging {
  id          String  @id @default(cuid())
  prisonerId  String
  description String
  quantity    Int     @default(1)
  condition   String?
  returned    Boolean @default(false)
  inventoryFileId    String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)
  inventoryFile File?    @relation("BelongingInventory", fields: [inventoryFileId], references: [id], onDelete: SetNull)

  @@map("prisoner_belongings")
}

model PrisonerContact {
  id           String @id @default(cuid())
  prisonerId   String
  name         String
  relationship String
  phone        String

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  @@map("prisoner_contacts")
}

model PrisonerChild {
  id         String    @id @default(cuid())
  prisonerId String
  fullName   String
  birthDate  DateTime?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  @@map("prisoner_children")
}

//Model File:
model File {
  id String @id @default(cuid())

  // URLs y paths
  url         String
  storagePath String?

  // Metadata del archivo
  filename     String
  originalName String
  mimeType     String
  extension    String
  size         Int

  // Storage provider
  storageType String // "cloudinary" | "s3"

  // Relación polimórfica
  entityType String // "prisoner_identity", "medical_record", "belonging"
  entityId   String // ID de la entidad relacionada
  fieldName  String // "photo", "right_fingerprint", "left_fingerprint", etc

  // Auditoría
  createdBy String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Relaciones inversas
  identityPhotos      PrisonerIdentity[]  @relation("IdentityPhoto")
  userPhoto           User?               @relation("IdentityPhoto")
  identityRightPrints PrisonerIdentity[]  @relation("RightFingerprint")
  identityLeftPrints  PrisonerIdentity[]  @relation("LeftFingerprint")
  medicalRecords      MedicalRecord[]     @relation("MedicalFile")
  belongings          PrisonerBelonging[] @relation("BelongingInventory")

  mandates            PrisonerMandate[] @relation("MandateDocument")


  @@index([entityType, entityId])
  @@index([entityType, entityId, fieldName])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("files")
}

//////////////////////
// Prisoner Cases & Mandates
//////////////////////

enum CaseStatus {
  EnProceso
  Condenado
  Apelacion
  Cerrado
}

enum MandateType {
  Detencion
  Condena
  Libertad
  Apelacion
  Traslado
}

enum MandateStatus {
  Vigente
  Ejecutado
  Anulado
}

model PrisonerCase {
  id             String            @id @default(cuid())
  prisonerId     String
  caseNumber     String
  crime          String
  status         CaseStatus
  startDate      DateTime
  endDate        DateTime?
  courtName      String?
  judgeName      String?
  sentenceYears  Int?
  remarks        String?

  isDeleted      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String?
  updatedBy      String?

  prisoner       Prisoner          @relation(fields: [prisonerId], references: [id], onDelete: Cascade)
  mandates       PrisonerMandate[]

  @@map("prisoner_cases")
}

model PrisonerMandate {
  id          String         @id @default(cuid())
  caseId      String
  type        MandateType
  issueDate   DateTime
  fileId      String?
  file        File?          @relation("MandateDocument", fields: [fileId], references: [id], onDelete: SetNull)
  description String?
  status      MandateStatus

  isDeleted   Boolean        @default(false)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  case        PrisonerCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("prisoner_mandates")
}

//ACTIVIDAD

// ============================================================
// ENUMS PARA AUDITORÍA
// ============================================================

enum AuditAction {
  // Autenticación
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  TOKEN_REFRESHED
  
  // CRUD genérico
  CREATE
  READ
  UPDATE
  DELETE
  
  // Archivos
  FILE_UPLOAD
  FILE_DOWNLOAD
  FILE_DELETE
  FILE_VIEW
  
  // Prisioneros
  PRISONER_REGISTERED
  PRISONER_TRANSFERRED
  PRISONER_RELEASED
  PRISONER_STATUS_CHANGED
  
  // Identidad
  IDENTITY_CREATED
  IDENTITY_UPDATED
  IDENTITY_PHOTO_UPLOADED
  FINGERPRINT_UPLOADED
  
  // Personal
  PERSONAL_INFO_CREATED
  PERSONAL_INFO_UPDATED
  
  // Penitenciaria
  PENITENTIARY_INFO_CREATED
  PENITENTIARY_INFO_UPDATED
  CELL_CHANGED
  
  // Médico
  MEDICAL_RECORD_CREATED
  MEDICAL_RECORD_UPDATED
  MEDICAL_RECORD_DELETED
  MEDICAL_FILE_UPLOADED
  
  // Pertenencias
  BELONGING_REGISTERED
  BELONGING_UPDATED
  BELONGING_RETURNED
  BELONGING_INVENTORY_UPLOADED
  
  // Contactos
  CONTACT_ADDED
  CONTACT_UPDATED
  CONTACT_DELETED
  
  // Hijos
  CHILD_REGISTERED
  CHILD_UPDATED
  CHILD_DELETED
  
  // Casos judiciales (futuro)
  CASE_CREATED
  CASE_UPDATED
  CASE_CLOSED
  
  // Mandamientos (futuro)
  MANDATE_ISSUED
  MANDATE_EXECUTED
  MANDATE_ANNULLED
  
  // Reportes
  REPORT_GENERATED
  REPORT_DOWNLOADED
  
  // Administración
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_ROLE_CHANGED
  PERMISSIONS_CHANGED
}

enum AuditStatus {
  SUCCESS
  FAILED
  PENDING
  CANCELLED
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AuditModule {
  AUTH
  PRISONERS
  IDENTITY
  PERSONAL
  PENITENTIARY
  MEDICAL
  BELONGINGS
  CONTACTS
  CHILDREN
  CASES
  MANDATES
  FILES
  REPORTS
  USERS
  SYSTEM
}

enum EntityType {
  PRISONER
  PRISONER_IDENTITY
  PRISONER_PERSONAL
  PRISONER_PENITENTIARY
  MEDICAL_RECORD
  PRISONER_BELONGING
  PRISONER_CONTACT
  PRISONER_CHILD
  PRISONER_CASE
  PRISONER_MANDATE
  FILE
  SESSION
  USER
  ROLE
  PERMISSION
}

enum LogoutReason {
  USER_LOGOUT
  TOKEN_EXPIRED
  SESSION_TIMEOUT
  FORCE_LOGOUT_BY_ADMIN
  SUSPICIOUS_ACTIVITY
  PASSWORD_CHANGED
  ACCOUNT_DISABLED
  DEVICE_LIMIT_REACHED
}

// ============================================================
// TABLAS CON ENUMS
// ============================================================

model ActivityLog {
  id              String         @id @default(cuid())
  
  // ¿Quién?
  userId          String?
  userEmail       String?
  userName        String?
  userRole        String?
  
  // ¿Qué?
  action          AuditAction    // ✅ ENUM
  entityType      EntityType     // ✅ ENUM
  entityId        String?
  
  // ¿Cuándo?
  timestamp       DateTime       @default(now())

  // ¿Dónde?
  ipAddress       String?
  userAgent       String?

  // ¿Cómo?
  description     String
  metadata        Json?

  // Estado
  status          AuditStatus    @default(SUCCESS) // ✅ ENUM
  errorMessage    String?

  // Contexto
  module          AuditModule?   // ✅ ENUM
  severity        AuditSeverity  @default(INFO)    // ✅ ENUM

  // Relación directa con prisionero (opcional, para trazabilidad)
  prisonerRelatedId String?

  // Relaciones
  dataChanges     DataChangeLog[]
  sessionLogId    String?
  sessionLog      SessionLog?    @relation(fields: [sessionLogId], references: [id])

  @@index([userId, timestamp])
  @@index([entityType, entityId])
  @@index([prisonerRelatedId, timestamp])
  @@index([action, timestamp])
  @@index([module, timestamp])
  @@index([severity, timestamp])
  @@index([status, timestamp])
  @@map("activity_logs")
}

model SessionLog {
  id              String        @id @default(cuid())
  userId          String
  
  loginAt         DateTime      @default(now())
  logoutAt        DateTime?
  
  ipAddress       String
  userAgent       String
  deviceInfo      String?
  
  // Ubicación (opcional)
  country         String?
  city            String?
  
  // Estado
  isActive        Boolean       @default(true)
  logoutReason    LogoutReason? // ✅ ENUM
  
  // Relaciones
  activities      ActivityLog[]
  
  @@index([userId, loginAt])
  @@index([isActive])
  @@index([logoutReason])
  @@map("session_logs")
}

model DataChangeLog {
  id              String       @id @default(cuid())
  
  // Relación con activity log
  activityLogId   String?
  activityLog     ActivityLog? @relation(fields: [activityLogId], references: [id])
  
  entityType      EntityType   // ✅ ENUM
  entityId        String
  fieldName       String

  oldValue        String?
  newValue        String?

  changedBy       String
  changedAt       DateTime     @default(now())

  reason          String?

  // Relación directa con prisionero (opcional, para trazabilidad)
  prisonerRelatedId String?

  @@index([activityLogId])
  @@index([entityType, entityId, fieldName])
  @@index([prisonerRelatedId, changedAt])
  @@index([changedBy, changedAt])
  @@map("data_change_logs")
}